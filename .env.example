# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Supabase (Project Settings → API). The service-role key is SECRET: server only, never NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only for running migrations (node scripts/db-migrate.mjs).
# Supabase → Connect → Session pooler → URI, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public, baked into the app (safe to expose): project URL + publishable/anon key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Only for configuring auth from scripts/auth-setup.mts (Supabase account → Access Tokens)
SUPABASE_ACCESS_TOKEN=sbp_...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Resend (later): API key + verified sender
RESEND_API_KEY=re_...
MAIL_FROM=UBBW 2026 <team@ubblockchainweek.net>

# GIF library in network chat (developers.giphy.com → Create an App → API key). A GIPHY key is a
# client key by design (rate-limited, read-only), so it may ship in the site build. Leave empty to hide results.
NEXT_PUBLIC_GIPHY_API_KEY=
# Where the app is served (Supabase sign-in returns here). scripts/auth-setup.mts reads it.
APP_URL=https://ubbw-2026.vercel.app
